# Fresh-v2 installation only. Keep the existing project name when restarting v2.
# Use a new project for a fresh install; never reuse a v9 project or data volume.
COMPOSE_PROJECT_NAME=zhixu-v2-fresh
# Prefer image@sha256:digest from the verified release-manifest.json.
ZHIXU_V2_IMAGE=anysoft/zhixu:2.0.0
ZHIXU_V2_PUBLIC_ORIGIN=http://127.0.0.1:5600
ZHIXU_V2_PORT=5600
