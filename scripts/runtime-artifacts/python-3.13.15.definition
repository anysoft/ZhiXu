# ZhiXu-reviewed composition using the pinned upstream python-build DSL.
# This is a project build definition, not an unchanged pyenv release definition.
mkdir -p "$PREFIX_PATH/pip-wheels"
cp "$ZHIXU_RUNTIME_PIP_WHEEL" "$PREFIX_PATH/pip-wheels/pip-26.3-py3-none-any.whl"
package_option python configure --with-wheel-pkg-dir="$PREFIX_PATH/pip-wheels"
export SQLITE_PREFIX_PATH="$PREFIX_PATH/sqlite"
export SQLITE_CFLAGS="-fPIC"
package_option sqlite configure --disable-shared --enable-static --disable-readline
install_package "sqlite-autoconf-3540100" "https://sqlite.org/2026/sqlite-autoconf-3540100.tar.gz#926ef8d3eab93fbf6e06011901273eec076b25594a4e1cdadd50c987f4f6d64e" standard
export CPPFLAGS="-I$SQLITE_PREFIX_PATH/include $CPPFLAGS"
export LDFLAGS="-L$SQLITE_PREFIX_PATH/lib $LDFLAGS"
export PKG_CONFIG_PATH="$SQLITE_PREFIX_PATH/lib/pkgconfig:$PKG_CONFIG_PATH"
export LIBSQLITE3_CFLAGS="-I$SQLITE_PREFIX_PATH/include"
export LIBSQLITE3_LIBS="$SQLITE_PREFIX_PATH/lib/libsqlite3.a -lm"

export ZLIB_PREFIX_PATH="$PREFIX_PATH/zlib"
export ZLIB_CFLAGS="-fPIC"
export ZLIB_CONFIGURE_OPTS="--static"
install_package "zlib-1.4" "https://zlib.net/zlib-1.4.tar.gz#02dd159783677a749c04adbdd02b55b8a2bcc7e054f51b76b549199a916ad584" standard
export CPPFLAGS="-I$ZLIB_PREFIX_PATH/include $CPPFLAGS"
export LDFLAGS="-L$ZLIB_PREFIX_PATH/lib $LDFLAGS"
export PKG_CONFIG_PATH="$ZLIB_PREFIX_PATH/lib/pkgconfig:$PKG_CONFIG_PATH"

export OPENSSL_PREFIX_PATH="$PREFIX_PATH/openssl"
export OPENSSL_CONFIGURE="./config"
export OPENSSL_CFLAGS="-fPIC"
export OPENSSL_MAKE_INSTALL_TARGET="install_sw"
package_option openssl configure --libdir=lib --openssldir="$OPENSSL_PREFIX_PATH/ssl" no-shared no-tests no-apps no-zlib no-docs
install_package "openssl-3.5.9" "https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz#603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a" standard
export CPPFLAGS="-I$OPENSSL_PREFIX_PATH/include $CPPFLAGS"
export LDFLAGS="-L$OPENSSL_PREFIX_PATH/lib $LDFLAGS"
export PKG_CONFIG_PATH="$OPENSSL_PREFIX_PATH/lib/pkgconfig:$PKG_CONFIG_PATH"
package_option python configure --with-openssl="$OPENSSL_PREFIX_PATH" --with-openssl-rpath=no
mkdir -p "$OPENSSL_PREFIX_PATH/ssl"
cp "$ZHIXU_RUNTIME_CA_BUNDLE" "$OPENSSL_PREFIX_PATH/ssl/cert.pem"

install_package "readline-8.3" "https://ftp.gnu.org/gnu/readline/readline-8.3.tar.gz#fe5383204467828cd495ee8d1d3c037a7eba1389c22bc6a041f627976f9061cc" mac_readline --if has_broken_mac_readline
if has_tar_xz_support; then
  install_package "Python-3.13.15" "https://www.python.org/ftp/python/3.13.15/Python-3.13.15.tar.xz#1e66a7945a48390ee4c2a4268a0e4185884059a13c4aab6d148aa208deea4a76" standard verify_py313 copy_python_gdb ensurepip
else
  install_package "Python-3.13.15" "https://www.python.org/ftp/python/3.13.15/Python-3.13.15.tgz#c28d9d213c09b5b5ab2c29812950e12f746999e099b82894231be954b26baed9" standard verify_py313 copy_python_gdb ensurepip
fi
# CPython source inputs are unchanged. Only its known old bundled wheel in this
# newly built, privately owned Runtime is removed; ensurepip/venv use the native
# configured wheel directory above, including all subsequent Environment Builds.
rm -f "$PREFIX_PATH/lib/python3.13/ensurepip/_bundled/pip-26.2.1-py3-none-any.whl"
